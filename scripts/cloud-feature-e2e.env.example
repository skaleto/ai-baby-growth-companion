# Copy this file to scripts/cloud-feature-e2e.env.local and fill real cloud test credentials.
# The .local file is ignored by git.

E2E_API_BASE_URL=http://120.55.188.242:8300

# Required: existing caregiver account in the cloud test family.
E2E_CAREGIVER_PHONE=
E2E_CAREGIVER_INVITE=

# Optional: set these only when using a fresh test phone that has not joined any family.
# This intentionally defaults to disabled so real accounts are not accidentally added to test families.
E2E_ALLOW_CAREGIVER_ONBOARDING=0
E2E_CAREGIVER_ROLE=测试
E2E_CAREGIVER_IS_CAREGIVER=true

# Optional but required for full permission exit criteria.
E2E_VIEWER_PHONE=
E2E_VIEWER_INVITE=
E2E_ALLOW_VIEWER_ONBOARDING=0
E2E_VIEWER_ROLE=亲友
E2E_VIEWER_IS_CAREGIVER=false

# Set to 0 when you only want CRUD/layout checks and do not want to call the live model.
E2E_RUN_AGENT=1
