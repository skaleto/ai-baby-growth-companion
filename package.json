{
  "name": "ai-baby-growth-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts --host 0.0.0.0",
    "build": "tsc -p frontend/tsconfig.json && vite build --config frontend/vite.config.ts",
    "setup:frontend-smoke": "playwright install chromium",
    "smoke:frontend": "node scripts/frontend-smoke.mjs",
    "review:vision": "node scripts/vision-review.mjs",
    "review:vision:cloud": "node scripts/vision-review.mjs .verification/cloud-feature-e2e",
    "test:cloud-e2e": "node scripts/cloud-feature-e2e.mjs",
    "test:agent-benchmark": "node scripts/agent-benchmark.mjs",
    "test:agent-harness-live": "node scripts/agent-harness-live-benchmark.mjs",
    "test:agent-l2:unit": "node scripts/test-l2-assertions.mjs && node scripts/test-l2-coverage-matrix.mjs && node scripts/test-album-domain.mjs && node scripts/test-album-merge-guard.mjs && node scripts/test-media-capture-date.mjs && node scripts/test-care-log-helpers.mjs && node scripts/test-agent-product-coverage-index.mjs && node scripts/test-native-capability-audit.mjs && node scripts/test-app-function-coverage-index.mjs && node scripts/test-capability-manifest.mjs && node scripts/test-preview-video-math.mjs",
    "test:app-function-coverage-index": "node scripts/test-app-function-coverage-index.mjs",
    "test:native-capability-audit": "node scripts/test-native-capability-audit.mjs",
    "test:album-domain": "node scripts/test-album-domain.mjs",
    "test:preview-video-math": "node scripts/test-preview-video-math.mjs",
    "test:album-merge-guard": "node scripts/test-album-merge-guard.mjs",
    "test:agent-l2": "node scripts/agent-l2-benchmark.mjs",
    "test:chat-quick-actions": "node scripts/test-chat-quick-actions.mjs",
    "test:product-simplification": "node scripts/test-product-simplification.mjs",
    "test:voice-capture-panel": "node scripts/test-voice-capture-panel.mjs",
    "test:care-log-stats": "node scripts/test-care-log-stats.mjs",
    "test:feeding-alarm-view": "node scripts/test-feeding-alarm-view.mjs",
    "gen:sleep-noise": "node scripts/gen-sleep-noise.mjs",
    "test:media-cache": "node scripts/test-media-cache.mjs",
    "test:app-state-contract": "node scripts/test-app-state-contract.mjs",
    "test:preview-swipe-math": "node scripts/test-preview-swipe-math.mjs",
    "test:preview-gestures": "node scripts/test-preview-gestures.mjs",
    "test:core-flows": "node scripts/test-core-flows.mjs",
    "test:feeding-alarm": "node scripts/test-feeding-alarm.mjs",
    "verify:frontend": "npm run test:chat-quick-actions && npm run test:product-simplification && npm run test:voice-capture-panel && npm run test:care-log-stats && npm run test:feeding-alarm-view && npm run test:media-cache && npm run test:app-state-contract && npm run test:preview-swipe-math && npm run build && npm run smoke:frontend && npm run test:preview-gestures && npm run test:core-flows && npm run test:feeding-alarm",
    "build:mobile:update": "bash scripts/build-mobile-update.sh",
    "build:android:debug": "bash scripts/build-android-debug.sh",
    "build:ios:debug": "bash scripts/build-ios-debug.sh",
    "deploy:aliyun": "bash scripts/deploy-aliyun-ecs.sh",
    "preview": "vite preview --config frontend/vite.config.ts --host 0.0.0.0",
    "mobile:init": "npm run build && cap add ios && cap add android",
    "mobile:sync": "npm run build && cap sync",
    "mobile:ios": "npm run mobile:sync && cap open ios",
    "mobile:android": "npm run mobile:sync && cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.1",
    "@capacitor/local-notifications": "^8.0.2",
    "@capgo/capacitor-updater": "^8.45.11",
    "@mediagrid/capacitor-native-audio": "^3.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "antd-mobile": "^5.42.3",
    "lucide-react": "^0.468.0",
    "photoswipe": "^5.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "playwright": "^1.60.0"
  }
}
